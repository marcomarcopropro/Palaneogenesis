# Build output / caches (regenerated by Gradle - never commit)
/build/
/.gradle/
/bin/
/out/

# Forge dev run folders
/run/
/run-data/
/eclipse/

# IDE-generated (Eclipse / VS Code Java extension / IntelliJ)
/.classpath
/.project
/.settings/
/.metadata/
*.launch
/.idea/
*.iml
*.ipr
*.iws

# Forge MDK leftovers
forge*changelog.txt

# NOTE: .vscode/ is intentionally NOT ignored (owner decision).
# NOTE: gradlew, gradlew.bat and gradle/wrapper/ must stay tracked.
