 public final class EyeFlareRenderEvents {
@@ -86,9 +96,34 @@ public final class EyeFlareRenderEvents {
 	 * de la cabeza (mismo motivo que MOUTH_FORWARD_OFFSET en PlayerBeamRenderEvents, valor más
